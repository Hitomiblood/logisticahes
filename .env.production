# Este archivo contiene las variables de entorno para PRODUCCIÓN
# Copiar a .env y configurar valores apropiados

# ========================================
# CONFIGURACIÓN DE ENTORNO
# ========================================
ENVIRONMENT=production

# ========================================
# CONFIGURACIÓN DE BASE DE DATOS
# ========================================
DB_TYPE=postgresql

# PostgreSQL - CAMBIAR PASSWORD EN PRODUCCIÓN
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=logistica_user
POSTGRES_PASSWORD=logistica_password_2026
POSTGRES_DB=logistica_hesego

# ========================================
# CONFIGURACIÓN DE REDIS
# ========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CACHE_TTL=300

# ========================================
# CONFIGURACIÓN DEL SERVIDOR API
# ========================================
API_HOST=0.0.0.0
API_PORT=8000

# CORS - Orígenes permitidos
CORS_ORIGINS=*

# ========================================
# CONFIGURACIÓN DE LOGGING
# ========================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ========================================
# SEGURIDAD
# ========================================
WEBHOOK_SECRET=hesego_logistica_2024_secure_key

# ========================================
# PATHS DE DATOS
# ========================================
DATA_DIR=/app/data
