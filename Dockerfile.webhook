FROM python:3.11-slim

# Crear usuario no-root
RUN groupadd -r webhook && useradd -r -g webhook webhook

# Directorio de trabajo
WORKDIR /app

# Instalar dependencias del webhook
RUN pip install --no-cache-dir flask werkzeug

# Copiar script del webhook
COPY webhook_server.py .

# Crear directorio de datos
RUN mkdir -p /app/data && chown -R webhook:webhook /app

# Cambiar a usuario no-root
USER webhook

# Puerto del webhook
EXPOSE 5000

# Comando de inicio
CMD ["python", "webhook_server.py"]
