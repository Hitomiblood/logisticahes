# ========================================
# CONFIGURACIÓN DE LOGÍSTICA HESEGO
# ========================================

# Entorno (development, production)
ENVIRONMENT=production

# ========================================
# CONFIGURACIÓN DE BASE DE DATOS
# ========================================
# Tipo de base de datos: sqlite o postgresql
DB_TYPE=postgresql

# PostgreSQL (usar cuando DB_TYPE=postgresql)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=logistica_user
POSTGRES_PASSWORD=logistica_password_2026
POSTGRES_DB=logistica_hesego

# SQLite (usar cuando DB_TYPE=sqlite para desarrollo local)
SQLITE_PATH=backend/logistica.db

# ========================================
# CONFIGURACIÓN DE REDIS
# ========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CACHE_TTL=300

# ========================================
# CONFIGURACIÓN DEL SERVIDOR API
# ========================================
API_HOST=0.0.0.0
API_PORT=8000

# CORS - Orígenes permitidos (separados por coma)
CORS_ORIGINS=*

# ========================================
# CONFIGURACIÓN DE LOGGING
# ========================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ========================================
# SEGURIDAD
# ========================================
# Secreto para webhooks (cambiar en producción)
WEBHOOK_SECRET=hesego_logistica_2024_secure_key

# ========================================
# PATHS DE DATOS
# ========================================
# Directorio base de datos Excel
DATA_DIR=/app/data
